+def _sidebar_items(value):
+    return [item.strip() for item in value.split(';') if item.strip()]
+
+
+def _sidebar_set_membership(value, item, enabled):
+    items = [entry for entry in _sidebar_items(value) if entry != item]
+    if enabled:
+        items.append(item)
+    return ';'.join(items)
+
+
+def _sidebar_mapping(value):
+    result = {}
+    for item in _sidebar_items(value):
+        key, separator, mapped = item.partition('=')
+        if separator and key.strip():
+            result[key.strip()] = mapped.strip()
+    return result
+
+
+def _sidebar_set_mapping(value, key, mapped):
+    values = _sidebar_mapping(value)
+    if mapped:
+        values[key] = mapped
+    else:
+        values.pop(key, None)
+    return ';'.join(f"{item}={mapped_value}" for item, mapped_value in values.items())
+
