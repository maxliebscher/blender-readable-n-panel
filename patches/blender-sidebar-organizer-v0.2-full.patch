+struct PanelCategoryViewItem {
+  PanelCategoryDyn *category;
+  int native_index;
+  std::string label;
+  std::string group;
+  bool favorite;
+  int color;
+  int custom_order;
+};
+
+static std::string_view panel_category_trim(std::string_view value)
+{
+  while (!value.empty() && ELEM(value.front(), ' ', '\t', '\n', '\r')) {
+    value.remove_prefix(1);
+  }
+  while (!value.empty() && ELEM(value.back(), ' ', '\t', '\n', '\r')) {
+    value.remove_suffix(1);
+  }
+  return value;
+}
+
+static bool panel_category_list_contains(const char *encoded, const std::string_view key)
+{
+  const std::string_view source = encoded ? encoded : "";
+  size_t start = 0;
+  while (start <= source.size()) {
+    const size_t end = source.find(';', start);
+    const std::string_view item = panel_category_trim(
+        source.substr(start, end == std::string_view::npos ? source.size() - start : end - start));
+    if (item == key) {
+      return true;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return false;
+}
+
+static void panel_category_list_toggle(char *encoded,
+                                       const size_t encoded_capacity,
+                                       const std::string_view key)
+{
+  const std::string_view source = encoded ? encoded : "";
+  std::vector<std::string> items;
+  bool removed = false;
+  size_t start = 0;
+  while (start <= source.size()) {
+    const size_t end = source.find(';', start);
+    const std::string_view item = panel_category_trim(
+        source.substr(start, end == std::string_view::npos ? source.size() - start : end - start));
+    if (!item.empty()) {
+      if (item == key) {
+        removed = true;
+      }
+      else {
+        items.emplace_back(item);
+      }
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  if (!removed && !key.empty()) {
+    items.emplace_back(key);
+  }
+
+  std::string result;
+  for (const std::string &item : items) {
+    if (!result.empty()) {
+      result += ';';
+    }
+    result += item;
+  }
+  BLI_strncpy(encoded, result.c_str(), encoded_capacity);
+}
+
+static int panel_category_list_index(const char *encoded, const std::string_view key)
+{
+  const std::string_view source = encoded ? encoded : "";
+  size_t start = 0;
+  int index = 0;
+  while (start <= source.size()) {
+    const size_t end = source.find(';', start);
+    const std::string_view item = panel_category_trim(
+        source.substr(start, end == std::string_view::npos ? source.size() - start : end - start));
+    if (item == key) {
+      return index;
+    }
+    if (!item.empty()) {
+      index++;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return -1;
+}
+
+static std::string panel_category_mapping_value(const char *encoded, const std::string_view key)
+{
+  const std::string_view source = encoded ? encoded : "";
+  size_t start = 0;
+  while (start <= source.size()) {
+    const size_t end = source.find(';', start);
+    const std::string_view item = panel_category_trim(
+        source.substr(start, end == std::string_view::npos ? source.size() - start : end - start));
+    const size_t separator = item.find('=');
+    if (separator != std::string_view::npos && panel_category_trim(item.substr(0, separator)) == key)
+    {
+      return std::string(panel_category_trim(item.substr(separator + 1)));
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    start = end + 1;
+  }
+  return {};
+}
+
+static bool panel_category_filter_matches(const PanelCategoryViewItem &item)
+{
+  if (U.panel_tabs_filter[0] == '\0') {
+    return true;
+  }
+  return BLI_strcasestr(item.category->idname, U.panel_tabs_filter) ||
+         BLI_strcasestr(item.label.c_str(), U.panel_tabs_filter) ||
+         BLI_strcasestr(item.group.c_str(), U.panel_tabs_filter);
+}
+
+static std::vector<PanelCategoryViewItem> panel_category_view_items(const ARegion *region,
+                                                                   const bool organize = true)
+{
+  std::vector<PanelCategoryViewItem> items;
+  const char *active = region->runtime->category;
+  int native_index = 0;
+  for (PanelCategoryDyn &category : region->runtime->panels_category) {
+    const std::string_view id = category.idname;
+    std::string alias = organize ? panel_category_mapping_value(U.panel_tabs_aliases, id) :
+                                   std::string();
+    PanelCategoryViewItem item = {&category,
+                                  native_index++,
+                                  alias.empty() ? std::string(IFACE_(category.idname)) : alias,
+                                  organize ? panel_category_mapping_value(U.panel_tabs_groups, id) :
+                                             std::string(),
+                                  organize && panel_category_list_contains(U.panel_tabs_favorites, id),
+                                  0,
+                                  organize ? panel_category_list_index(U.panel_tabs_custom_order, id) :
+                                             -1};
+    const std::string color = organize ? panel_category_mapping_value(U.panel_tabs_colors, id) :
+                                         std::string();
+    if (!color.empty()) {
+      item.color = std::clamp(atoi(color.c_str()), 0, 8);
+    }
+
+    const bool is_active = active && STREQ(active, category.idname);
+    if (organize && panel_category_list_contains(U.panel_tabs_hidden, id) && !is_active) {
+      continue;
+    }
+    if (organize && !panel_category_filter_matches(item) && !is_active) {
+      continue;
+    }
+    items.push_back(std::move(item));
+  }
+
+  if (!organize) {
+    return items;
+  }
+
+  const bool favorites_first = U.panel_tabs_organizer_flags & USER_PANEL_TABS_FAVORITES_FIRST;
+  const bool group_headers = U.panel_tabs_organizer_flags & USER_PANEL_TABS_GROUP_HEADERS;
+  const eUserPanelTabsSortMode sort_mode = U.panel_tabs_sort_mode;
+  std::stable_sort(items.begin(), items.end(), [&](const auto &a, const auto &b) {
+    if (favorites_first && a.favorite != b.favorite) {
+      return a.favorite;
+    }
+    if (group_headers && a.group != b.group) {
+      if (a.group.empty() != b.group.empty()) {
+        return !a.group.empty();
+      }
+      return BLI_strcasecmp_natural(a.group.c_str(), b.group.c_str()) < 0;
+    }
+    if (sort_mode == USER_PANEL_TABS_SORT_ALPHABETICAL) {
+      return BLI_strcasecmp_natural(a.label.c_str(), b.label.c_str()) < 0;
+    }
+    if (sort_mode == USER_PANEL_TABS_SORT_CUSTOM) {
+      if ((a.custom_order >= 0) != (b.custom_order >= 0)) {
+        return a.custom_order >= 0;
+      }
+      if (a.custom_order >= 0 && a.custom_order != b.custom_order) {
+        return a.custom_order < b.custom_order;
+      }
+    }
+    return a.native_index < b.native_index;
+  });
+  return items;
+}
+
+float panel_category_tabs_width(const ARegion *region)
+{
+  if ((U.flag & USER_FLAG_PANEL_TABS_HORIZONTAL_TEXT) == 0) {
+    return UI_PANEL_CATEGORY_MARGIN_WIDTH;
+  }
+
+  const bool fixed = U.panel_tabs_width_mode == USER_PANEL_TABS_WIDTH_FIXED;
+  float width;
+  float max_width;
+
+  if (fixed) {
+    const float fixed_width = U.panel_tabs_fixed_width > 0.0f ? U.panel_tabs_fixed_width : 8.0f;
+    width = std::clamp(fixed_width, 3.0f, 20.0f) * U.widget_unit;
+    max_width = width;
+  }
+  else {
+    const float min_width_units = U.panel_tabs_auto_min_width > 0.0f ?
+                                      U.panel_tabs_auto_min_width :
+                                      5.0f;
+    const float max_width_units = std::max(
+        min_width_units,
+        U.panel_tabs_auto_max_width > 0.0f ? U.panel_tabs_auto_max_width : 9.0f);
+    width = min_width_units * U.widget_unit;
+    max_width = max_width_units * U.widget_unit;
+  }
+
+  if (region && !fixed) {
+    const uiFontStyle *fstyle = &style_get()->widget;
+    for (const PanelCategoryViewItem &item : panel_category_view_items(region)) {
+      const float text_width = fontstyle_string_width(fstyle, item.label.c_str());
+      const float icon_width = (item.category->icon != ICON_NONE || item.color != 0) ? UI_UNIT_X :
+                                                                                     0.0f;
+      const float horizontal_padding = 0.75f * UI_UNIT_X;
+      width = std::max(width, text_width + icon_width + horizontal_padding);
+      if (!item.group.empty()) {
+        width = std::max(
+            width, fontstyle_string_width(fstyle, item.group.c_str()) + horizontal_padding);
+      }
+    }
+  }
+
+  width = std::min(width, max_width);
